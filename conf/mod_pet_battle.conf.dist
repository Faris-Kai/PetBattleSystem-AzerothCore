[worldserver]
########################################
# mod-pet-battle
########################################
#    PetBattle.Enable
#        Description: Enables or completely disables the pet battle system
#                     (the /dp command) on the server.
#        Default:     1 (enabled)
PetBattle.Enable = 1

###################################################################
# PetBattle.UseGossipUI
#     Description: Si esta en 1, ademas de los mensajes del addon
#                   el servidor abre ventanas de gossip para elegir
#                   equipo, tirar el dado y atacar. Si esta en 0,
#                   toda la interaccion queda 100% a cargo del addon
#                   PetBattleUI (sin ninguna ventana de gossip).
#     Default:      0 - Modo: Interfaz Addon
#                   1 - Modo: gossip habilitado, compatible con versiones
#                   anteriores
#                   
###################################################################
PetBattle.UseGossipUI = 0

# Displays a spell effect when summoning the pet.
# VisualSpellId = any spell visual you want.
PetBattle.SummonVisualSpellId = 47292

# Displays the [PETDMG] messages used for debugging/addons.
# 0 = disabled / 1 = enabled
PetBattle.DebugDamageMessages = 0

# Time limit in seconds for the responding player.
PetBattle.TurnTimeoutSeconds = 15
# Maximum distance allowed for combat.
PetBattle.ChallengeMaxDistance = 10

# XP percentage awarded against wild pets.
PetBattle.XpPercentVsWild = 5
# XP percentage awarded in PvP battles.
PetBattle.XpPercentVsPvp = 15

# HP percentage at which the survival instinct is triggered.
PetBattle.HealBelowPercent = 25
# Chance for an attack to be replaced by a heal.
PetBattle.HealChance = 15
# Minimum healing amount.
PetBattle.HealMin = 15
# Maximum healing amount.
PetBattle.HealMax = 45

# Visual played on the pet that heals itself (its own ability
# or auto-heal when HP is low). 0 = uses the normal attack emote.
PetBattle.HealVisualSpellId = 24209
# Visual played on the attacking pet when the damage is BELOW the
# fixed threshold of 19 (see PET_DAMAGE_VISUAL_THRESHOLD in the .cpp).
# 0 = uses the normal attack emote.
PetBattle.DamageVisualSpellIdLow = 24209
# Visual played on the attacking pet when the damage is GREATER THAN OR EQUAL
# to the threshold. 0 = uses the normal attack emote.
PetBattle.DamageVisualSpellIdHigh = 24209
