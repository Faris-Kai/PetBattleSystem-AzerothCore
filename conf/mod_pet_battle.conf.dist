[worldserver]
########################################
# mod-pet-battle
########################################
#
#	Español
#    PetBattle.Enable
#        Descripcion: Activa o desactiva por completo el sistema de combate
#                      de mascotas (comando /dp) en el servidor.
#        Default:     1 (activado)
#
#	English
#    PetBattle.Enable
#        Description: Enables or disables the pet battle system
#                     (/dp command) on the server.
#        Default:     1 (enabled

PetBattle.Enable = 1

# Distancia limite para combatir
PetBattle.ChallengeMaxDistance = 10

#
#	Español
#		Muestra efecto spell al invocar la mascotas
#		VisualSpellId = que quieras
#
#	English
#		Displays a spell effect when summoning the pet
#		VisualSpellId = any spell ID you want

PetBattle.SummonVisualSpellId = 47292

#
#	Español
#		Tiempo limite en seg para que el jugador de respuesta 
#
#	English
#		Time limit in seconds for the player to respond

PetBattle.TurnTimeoutSeconds = 15

# Experiencia ganada vs criaturas
PetBattle.XpPercentVsWild = 5

# Experiencia ganada vs criaturas Jugadores
PetBattle.XpPercentVsPvp = 15

# Cantidad de vida para activar instinto de supervivencia
PetBattle.HealBelowPercent = 25

# Probabilidad de que el ataque cambie a una cura
PetBattle.HealChance = 15

# Cura minima
PetBattle.HealMin = 15

# Cura maxima
PetBattle.HealMax = 45