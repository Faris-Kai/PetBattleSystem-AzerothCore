<Ui xmlns="http://www.blizzard.com/wow/ui/">

  <Frame
      name="PetBattleUI_TeamFrame"
      toplevel="true"
      frameStrata="HIGH"
      hidden="true"
      parent="UIParent"
      movable="false"
      enableMouse="true">

    <Size x="390" y="420"/>

    <Anchors>
      <Anchor point="CENTER" x="0" y="0"/>
    </Anchors>

    <Backdrop
        bgFile="Interface\DialogFrame\UI-DialogBox-Background"
        edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
        tile="true">

      <BackgroundInsets
          left="12"
          right="12"
          top="12"
          bottom="12"/>

      <TileSize val="32"/>
      <EdgeSize val="32"/>

    </Backdrop>


    <Layers>

      <Layer level="ARTWORK">

        <!-- ================================================== -->
        <!-- TITULO -->
        <!-- ================================================== -->

        <FontString
            name="$parentTitle"
            inherits="GameFontNormalLarge"
            justifyH="CENTER"
            text="">

          <Size x="340" y="24"/>

          <Anchors>
            <Anchor
                point="TOP"
                x="0"
                y="-16"/>
          </Anchors>

        </FontString>


        <!-- ================================================== -->
        <!-- SUBTITULO -->
        <!-- ================================================== -->

        <FontString
			name="$parentSubtitle"
			inherits="GameFontHighlightSmall"
			justifyH="CENTER"
			justifyV="TOP"
			text="">
		
		<Size x="360" y="18"/>
		
		<Anchors>
			<Anchor
				point="TOP"
				relativeTo="$parentTitle"
				relativePoint="BOTTOM"
				x="0"
				y="-2"/>
		</Anchors>
		
		</FontString>


        <!-- ================================================== -->
        <!-- SUBTITULO 2 -->
        <!-- ================================================== -->

        <FontString
            name="$parentSubtitle2"
            inherits="GameFontHighlightSmall"
            justifyH="CENTER"
            text="">

          <Size x="360" y="18"/>

          <Anchors>
            <Anchor
                point="TOP"
                relativeTo="$parentSubtitle"
                relativePoint="BOTTOM"
                x="0"
                y="0"/>
          </Anchors>

        </FontString>

      </Layer>

    </Layers>


    <Frames>


      <!-- ================================================== -->
      <!-- SLOT 1 -->
      <!-- ================================================== -->

      <Button name="PetBattleUI_TeamSlot1">

        <Size x="360" y="84"/>

        <Anchors>
          <Anchor
              point="TOP"
              relativePoint="TOP"
              x="0"
              y="-100"/>
        </Anchors>


        <Backdrop
            bgFile="Interface\Tooltips\UI-Tooltip-Background"
            edgeFile="Interface\Tooltips\UI-Tooltip-Border"
            tile="true">

          <BackgroundInsets
              left="2"
              right="2"
              top="2"
              bottom="2"/>

          <TileSize val="16"/>
          <EdgeSize val="12"/>

        </Backdrop>


        <Layers>

          <Layer level="ARTWORK">

            <FontString
                name="$parentNumber"
                inherits="GameFontNormalLarge"
                justifyH="CENTER"
                justifyV="MIDDLE"
                text="1">

              <Size x="22" y="40"/>

              <Anchors>
                <Anchor
                    point="LEFT"
                    x="2"
                    y="0"/>
              </Anchors>

            </FontString>


            <Texture
                name="$parentIcon"
                file="Interface\PaperDoll\UI-Backpack-EmptySlot">

              <Size x="72" y="72"/>

              <Anchors>
                <Anchor
                    point="LEFT"
                    relativeTo="$parentNumber"
                    relativePoint="RIGHT"
                    x="4"
                    y="0"/>
              </Anchors>

            </Texture>


            <FontString
                name="$parentName"
                inherits="GameFontNormal"
                justifyH="LEFT"
                justifyV="MIDDLE">

              <Size x="150" y="20"/>

              <Anchors>
                <Anchor
                    point="TOPLEFT"
                    relativeTo="$parentIcon"
                    relativePoint="TOPRIGHT"
                    x="5"
                    y="-5"/>
              </Anchors>

            </FontString>


            <FontString
                name="$parentType"
                inherits="GameFontHighlightSmall"
                justifyH="LEFT"
                justifyV="MIDDLE">

              <Size x="150" y="18"/>

              <Anchors>
                <Anchor
                    point="TOPLEFT"
                    relativeTo="$parentName"
                    relativePoint="BOTTOMLEFT"
                    x="0"
                    y="0"/>
              </Anchors>

            </FontString>


            <FontString
                name="$parentDamage"
                inherits="GameFontHighlightSmall"
                justifyH="LEFT"
                justifyV="MIDDLE">

              <Size x="150" y="18"/>

              <Anchors>
                <Anchor
                    point="TOPLEFT"
                    relativeTo="$parentType"
                    relativePoint="BOTTOMLEFT"
                    x="0"
                    y="0"/>
              </Anchors>

            </FontString>

          </Layer>

        </Layers>


        <Frames>

          <PlayerModel
              name="$parentModel"
              frameStrata="DIALOG"
              enableMouse="false"
              hidden="false">

            <Size x="180" y="180"/>

            <Anchors>
              <Anchor
                  point="CENTER"
                  relativeTo="$parent"
                  relativePoint="CENTER"
                  x="110"
                  y="10"/>
            </Anchors>

          </PlayerModel>

        </Frames>


        <Scripts>

          <OnLoad>

            this.slotIndex = 1

            this:RegisterForClicks(
                "LeftButtonUp",
                "RightButtonUp"
            )

            this:RegisterForDrag(
                "LeftButton"
            )

          </OnLoad>


          <OnClick>
            PetBattleUI_Team_OnClick(this, button)
          </OnClick>


          <OnDragStart>
            PetBattleUI_Team_OnDragStart(this)
          </OnDragStart>


          <OnDragStop>
            PetBattleUI_Team_OnDragStop(this)
          </OnDragStop>


          <OnReceiveDrag>
            PetBattleUI_Team_OnReceiveDrag(this)
          </OnReceiveDrag>

        </Scripts>

      </Button>


