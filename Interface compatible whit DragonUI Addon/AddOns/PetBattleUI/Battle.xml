<Ui xmlns="http://www.blizzard.com/wow/ui/">

  <Frame
    name="PetBattleUI_BattleFrame"
    toplevel="true"
    frameStrata="MEDIUM"
    hidden="true"
    parent="UIParent"
    movable="true"
    enableMouse="true"
    clampedToScreen="true"
  >

    <Size
      x="360"
      y="264"
    />

    <Anchors>

      <Anchor
        point="CENTER"
        x="0"
        y="140"
      />

    </Anchors>


    <!-- ====================================================== -->
    <!-- BACKDROP -->
    <!-- ====================================================== -->

    <Backdrop
      bgFile="Interface\DialogFrame\UI-DialogBox-Background"
      edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
      tile="true"
    >

      <BackgroundInsets
        left="11"
        right="12"
        top="12"
        bottom="11"
      />

      <TileSize val="32"/>

      <EdgeSize val="32"/>

    </Backdrop>


    <!-- ====================================================== -->
    <!-- TEXTOS -->
    <!-- ====================================================== -->

    <Layers>

      <Layer level="ARTWORK">


        <!-- ================================================== -->
        <!-- ENEMIGO -->
        <!-- ================================================== -->

        <FontString
          name="PetBattleUI_EnemyName"
          inherits="GameFontNormal"
          justifyH="LEFT"
        >

          <Anchors>

            <Anchor
              point="TOPLEFT"
              x="24"
              y="-22"
            />

          </Anchors>

        </FontString>


        <FontString
          name="PetBattleUI_EnemyType"
          inherits="GameFontHighlightSmall"
          justifyH="RIGHT"
        >

          <Anchors>

            <Anchor
              point="TOPRIGHT"
              x="-24"
              y="-22"
            />

          </Anchors>

        </FontString>


        <!-- ================================================== -->
        <!-- MASCOTA PROPIA -->
        <!-- ================================================== -->

        <FontString
          name="PetBattleUI_MyName"
          inherits="GameFontNormal"
          justifyH="LEFT"
        >

          <Anchors>

            <Anchor
              point="TOPLEFT"
              x="24"
              y="-90"
            />

          </Anchors>

        </FontString>


        <FontString
          name="PetBattleUI_MyType"
          inherits="GameFontHighlightSmall"
          justifyH="RIGHT"
        >

          <Anchors>

            <Anchor
              point="TOPRIGHT"
              x="-24"
              y="-90"
            />

          </Anchors>

        </FontString>

      </Layer>

    </Layers>


    <!-- ====================================================== -->
    <!-- ELEMENTOS -->
    <!-- ====================================================== -->

    <Frames>


      <!-- ==================================================== -->
      <!-- VIDA ENEMIGA -->
      <!-- ==================================================== -->

      <StatusBar
        name="PetBattleUI_EnemyHealthBar"
        minValue="0"
        maxValue="100"
        defaultValue="100"
      >

        <Size
          x="312"
          y="16"
        />

        <Anchors>

          <Anchor
            point="TOPLEFT"
            x="24"
            y="-40"
          />

        </Anchors>


        <BarTexture
          file="Interface\TargetingFrame\UI-StatusBar"
        />


        <BarColor
          r="0.85"
          g="0.2"
          b="0.2"
        />


        <Layers>

          <Layer level="BACKGROUND">

            <Texture
              setAllPoints="true"
            >

              <Color
                r="0.1"
                g="0.1"
                b="0.1"
                a="0.6"
              />

            </Texture>

          </Layer>

        </Layers>

      </StatusBar>


      <!-- ==================================================== -->
      <!-- VIDA PROPIA -->
      <!-- ==================================================== -->

      <StatusBar
        name="PetBattleUI_MyHealthBar"
        minValue="0"
        maxValue="100"
        defaultValue="100"
      >

        <Size
          x="312"
          y="16"
        />

        <Anchors>

          <Anchor
            point="TOPLEFT"
            x="24"
            y="-108"
          />

        </Anchors>


        <BarTexture
          file="Interface\TargetingFrame\UI-StatusBar"
        />


        <BarColor
          r="0.2"
          g="0.6"
          b="0.9"
        />


        <Layers>

          <Layer level="BACKGROUND">

            <Texture
              setAllPoints="true"
            >

              <Color
                r="0.1"
                g="0.1"
                b="0.1"
                a="0.6"
              />

            </Texture>

          </Layer>

        </Layers>

      </StatusBar>


      <!-- ==================================================== -->
      <!-- ATAQUE 1 -->
      <!-- ==================================================== -->

      <Button
        name="PetBattleUI_AttackIcon1"
        hidden="false"
        enableMouse="true"
      >

        <Size
          x="64"
          y="64"
        />

        <Anchors>

          <Anchor
            point="BOTTOMLEFT"
            x="28"
            y="40"
          />

        </Anchors>


        <Layers>


          <!-- ================================================= -->
          <!-- ICONO -->
          <!-- ================================================= -->

          <Layer level="ARTWORK">

            <Texture
              name="PetBattleUI_AttackIcon1Texture"
              setAllPoints="true"
            >

              <TextureCoords
                left="0.07"
                right="0.93"
                top="0.07"
                bottom="0.93"
              />

            </Texture>

          </Layer>


          <!-- ================================================= -->
          <!-- DAÑO -->
          <!-- ================================================= -->

          <Layer level="OVERLAY">

            <FontString
              name="PetBattleUI_AttackDamage1"
              inherits="GameFontHighlightLarge"
              justifyH="CENTER"
              justifyV="MIDDLE"
            >

              <Size
                x="80"
                y="24"
              />

              <Anchors>

                <Anchor
                  point="BOTTOM"
                  relativePoint="TOP"
                  x="0"
                  y="3"
                />

              </Anchors>

            </FontString>


            <!-- =============================================== -->
            <!-- COOLDOWN -->
            <!-- =============================================== -->

            <FontString
              name="PetBattleUI_AttackCD1"
              inherits="GameFontRedSmall"
              justifyH="CENTER"
            >

              <Size
                x="100"
                y="16"
              />

              <Anchors>

                <Anchor
                  point="TOP"
                  relativePoint="BOTTOM"
                  x="0"
                  y="-2"
                />

              </Anchors>

            </FontString>

          </Layer>

        </Layers>


        <Scripts>

          <OnClick>

            PetBattleUI_Battle_OnAttack(1)

          </OnClick>

        </Scripts>

      </Button>


      <!-- ==================================================== -->
      <!-- ATAQUE 2 -->
      <!-- ==================================================== -->

      <Button
        name="PetBattleUI_AttackIcon2"
        hidden="false"
        enableMouse="true"
      >

        <Size
          x="64"
          y="64"
        />

        <Anchors>

          <Anchor
            point="BOTTOM"
            x="0"
            y="40"
          />

        </Anchors>


        <Layers>


          <!-- ================================================= -->
          <!-- ICONO -->
          <!-- ================================================= -->

          <Layer level="ARTWORK">

            <Texture
              name="PetBattleUI_AttackIcon2Texture"
              setAllPoints="true"
            >

              <TextureCoords
                left="0.07"
                right="0.93"
                top="0.07"
                bottom="0.93"
              />

            </Texture>

          </Layer>


          <!-- ================================================= -->
          <!-- DAÑO -->
          <!-- ================================================= -->

          <Layer level="OVERLAY">

            <FontString
              name="PetBattleUI_AttackDamage2"
              inherits="GameFontHighlightLarge"
              justifyH="CENTER"
              justifyV="MIDDLE"
            >

              <Size
                x="80"
                y="24"
              />

              <Anchors>

                <Anchor
                  point="BOTTOM"
                  relativePoint="TOP"
                  x="0"
                  y="3"
                />

              </Anchors>

            </FontString>


            <!-- =============================================== -->
            <!-- COOLDOWN -->
            <!-- =============================================== -->

            <FontString
              name="PetBattleUI_AttackCD2"
              inherits="GameFontRedSmall"
              justifyH="CENTER"
            >

              <Size
                x="100"
                y="16"
              />

              <Anchors>

                <Anchor
                  point="TOP"
                  relativePoint="BOTTOM"
                  x="0"
                  y="-2"
                />

              </Anchors>

            </FontString>

          </Layer>

        </Layers>


        <Scripts>

          <OnClick>

            PetBattleUI_Battle_OnAttack(2)

          </OnClick>

        </Scripts>

      </Button>


      <!-- ==================================================== -->
      <!-- ATAQUE 3 -->
      <!-- ==================================================== -->

      <Button
        name="PetBattleUI_AttackIcon3"
        hidden="false"
        enableMouse="true"
      >

        <Size
          x="64"
          y="64"
        />

        <Anchors>

          <Anchor
            point="BOTTOMRIGHT"
            x="-28"
            y="40"
          />

        </Anchors>


        <Layers>


          <!-- ================================================= -->
          <!-- ICONO -->
          <!-- ================================================= -->

          <Layer level="ARTWORK">

            <Texture
              name="PetBattleUI_AttackIcon3Texture"
              setAllPoints="true"
            >

              <TextureCoords
                left="0.07"
                right="0.93"
                top="0.07"
                bottom="0.93"
              />

            </Texture>

          </Layer>


          <!-- ================================================= -->
          <!-- DAÑO -->
          <!-- ================================================= -->

          <Layer level="OVERLAY">

            <FontString
              name="PetBattleUI_AttackDamage3"
              inherits="GameFontHighlightLarge"
              justifyH="CENTER"
              justifyV="MIDDLE"
            >

              <Size
                x="80"
                y="24"
              />

              <Anchors>

                <Anchor
                  point="BOTTOM"
                  relativePoint="TOP"
                  x="0"
                  y="3"
                />

              </Anchors>

            </FontString>


            <!-- =============================================== -->
            <!-- COOLDOWN -->
            <!-- =============================================== -->

            <FontString
              name="PetBattleUI_AttackCD3"
              inherits="GameFontRedSmall"
              justifyH="CENTER"
            >

              <Size
                x="100"
                y="16"
              />

              <Anchors>

                <Anchor
                  point="TOP"
                  relativePoint="BOTTOM"
                  x="0"
                  y="-2"
                />

              </Anchors>

            </FontString>

          </Layer>

        </Layers>


        <Scripts>

          <OnClick>

            PetBattleUI_Battle_OnAttack(3)

          </OnClick>

        </Scripts>

      </Button>

    </Frames>


    <!-- ====================================================== -->
    <!-- MOVIMIENTO DEL FRAME -->
    <!-- ====================================================== -->

    <Scripts>

      <OnMouseDown>

        if button == "LeftButton" then

          this:StartMoving()

        end

      </OnMouseDown>


      <OnMouseUp>

        this:StopMovingOrSizing()

        PetBattleUI_SavePosition(
          this
        )

      </OnMouseUp>


      <OnHide>

        this:StopMovingOrSizing()

      </OnHide>

    </Scripts>

  </Frame>

</Ui>